# Copy to .env and fill in. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-sonnet-5)
# INTERCHANGE_MODEL=claude-haiku-4-5-20251001

# Optional: default generation engine ("api" or "claude-code").
# "claude-code" uses headless Claude Code on your Pro/Max subscription ($0 marginal, no API key needed).
# INTERCHANGE_ENGINE=claude-code

# A2A agent surface (a2a_agent/, ADR-0013). See a2a_agent/README.md.
# A2A_SIGNING_KEY_PEM=       # server: private ES256 key PEM the Agent Card is signed with; never commit
# A2A_PINNED_PUBLIC_KEY_PEM= # requester: public key PEM to trust, overriding the committed pin
# A2A_PINNED_KID=            # requester: kid the pinned public key applies to
# A2A_API_KEYS=              # server: "key:label,key2:label2" valid API keys and their caller labels
# A2A_API_KEY_HEADER=        # both: header name the API key is presented in
# A2A_PUBLIC_URL=            # server: base URL the Agent Card advertises; must be reachable by peers
# A2A_DEMO_PORT=             # demo: port make a2a-demo binds its ephemeral server to
# INTERCHANGE_COLLECTION=    # server: Chroma collection to answer from
# INTERCHANGE_DOCS_DIR=      # server: docs directory backing that collection
