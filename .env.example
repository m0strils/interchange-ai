# Copy to .env and fill in. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-sonnet-5)
# INTERCHANGE_MODEL=claude-haiku-4-5-20251001

# Optional: extra ignore patterns for corpus discovery, comma-separated
# (gitignore-lite: trailing "/" = directory, no negation, no "**"); added to the
# built-in defaults and docs/.interchangeignore.
INTERCHANGE_IGNORE=

# Private profiles overlay merged over the committed a2a_agent/profiles.yaml
# (ADR-0016). Unset uses the default ~/.interchange/profiles.yaml if it exists;
# an empty value disables the overlay; a path uses that file. Per named profile
# the overlay's keys replace the committed ones (lists replace whole), and a new
# name is added entire — so you can point a profile at your own corpus or add
# whole new ones without editing (or publishing) the committed file.
# INTERCHANGE_PROFILES=

# Where the local Chroma index lives (ADR-0016): expanduser'd, defaults to
# <repo>/.chroma. ONE store per machine, N collections — so `edi`, `vault`,
# `brain` and `research` share a single store instead of one per checkout. The
# second-brain setup points it at ~/.interchange/chroma, next to the overlay.
# INTERCHANGE_CHROMA_DIR=

# Absolute path to the Obsidian vault backing the committed `vault` profile,
# whose docs_dir is the `${INTERCHANGE_VAULT_DIR}` placeholder — so this must be
# exported in the shell or passed on the make line (e.g. `make reindex
# PROFILE=vault`) for that committed block to resolve. With `--profile` the profile
# is now applied in-process (ADR-0016), so the old "export before .env, DOCS_DIR
# resolves at import" caveat is retired for any profile whose docs_dir is set
# outright by an overlay; the env var is still needed only for the committed
# vault block's `${INTERCHANGE_VAULT_DIR}` placeholder.
INTERCHANGE_VAULT_DIR=

# Retrieval eval golden set for the active profile (used by `make eval`).
INTERCHANGE_GOLDEN=

# Reranker backend for the `hybrid+rerank` retrieval mode (ADR-0007/0014).
# One of: cross-encoder | flashrank | typesafe. Defaults to the LOCAL cross-encoder
# ($0, offline, telemetry "measured"); flashrank is the torch-less local fallback.
# "typesafe" is METERED (calibrated Noul per candidate, telemetry "estimated") and
# needs TYPESAFE_API_KEY below. Install the backend: pip install -r requirements-rerank.txt
INTERCHANGE_RERANK=
# TypeSafe System One API key — required ONLY when INTERCHANGE_RERANK=typesafe.
# Metered; never used by the offline test gate. Get one at https://typesafe.ai
# On macOS, pull it from the keychain at run time instead of storing it here: TYPESAFE_API_KEY="$(security find-generic-password -s typesafe -w)"
TYPESAFE_API_KEY=

# Optional: default generation engine: "api", "claude-code", or "stub" (offline echo engine for tests and demos).
# "claude-code" uses headless Claude Code on your Pro/Max subscription ($0 marginal, no API key needed).
# INTERCHANGE_ENGINE=claude-code

# A2A agent surface (a2a_agent/, ADR-0013). See a2a_agent/README.md.
# A2A_SIGNING_KEY_PEM=       # server: private ES256 key PEM the Agent Card is signed with; never commit
# A2A_PINNED_PUBLIC_KEY_PEM= # requester: public key PEM to trust, overriding the committed pin
# A2A_PINNED_KID=            # requester: kid the pinned public key applies to
# A2A_API_KEYS=              # server: "key:label,key2:label2" valid API keys and their caller labels
# A2A_API_KEY_HEADER=        # both: header name the API key is presented in
# A2A_PUBLIC_URL=            # server: base URL the Agent Card advertises; must be reachable by peers
# A2A_DEMO_PORT=             # demo: port make a2a-demo binds its ephemeral server to
# INTERCHANGE_COLLECTION=    # server: Chroma collection to answer from
# INTERCHANGE_DOCS_DIR=      # server: docs directory backing that collection

# --- Browser workbench + HTTP policy tier (ADR-0015) ----------------------
# The web/HTTP surface (/ask, /ask/stream, /options, /ui) reads these at request
# time; env is the policy tier and a request is the preference tier, policy wins.
# Corpora a web/HTTP request may name (comma-separated); `vault` is only reachable
# if you list it here. Default: edi,hotel.
INTERCHANGE_CORPORA=
# Knobs a request may NOT override (comma-separated subset of mode,rerank,k). A
# locked knob that a request tries to set is refused 403, never silently downgraded.
INTERCHANGE_LOCKED=
# Allow the metered `rerank=typesafe` backend at all. 0 (default) => 403; 1 => permitted
# up to the daily budget below (and still needs TYPESAFE_API_KEY).
INTERCHANGE_ALLOW_METERED=0
# Daily budget (USD) for metered calls, enforced against every *billed* audit row
# (marginal_usd > 0: `api` generation and metered rerank), so real API generation
# counts too. Checked on every /ask* request whose engine is `api` or whose rerank
# is metered. Over budget => 429 budget_exceeded. Default 1.00.
INTERCHANGE_METERED_BUDGET_USD=1.00
# Max concurrent generations; a further request gets 429 busy (Retry-After: 5). Default 2.
INTERCHANGE_MAX_CONCURRENT=2
# Per-client-host rate limit (requests/min, token bucket) => 429 rate_limited. Default 10.
# The bucket keys on the SOCKET PEER (request.client.host), not on any forwarded
# header. Behind a reverse proxy every caller shares the proxy's IP and collapses into
# one bucket (deliberately conservative). X-Forwarded-For is NOT trusted (it is
# client-spoofable); a TRUSTED_PROXY parse is a follow-up before any non-localhost,
# behind-a-proxy deploy.
INTERCHANGE_RATE_PER_MIN=10
# HMAC key for pin capability tokens. Set to share tokens across workers; otherwise
# random per process (fine for a single-worker demo).
INTERCHANGE_PIN_SECRET=
# Serve the /ui mount. 1 (default) mounts it; 0 skips it (API-only operators).
INTERCHANGE_UI=1
# Note: on a PUBLIC deploy (A2A_PUBLIC_URL host not localhost), /ask* require
# X-API-Key from A2A_API_KEYS above — unset keys fail closed (403).
